# docker-compose.override.yml
# This file is automatically merged with docker-compose.yml by Docker Compose
# in local development environments.
# It is intentionally excluded from git (see .gitignore).
#
# Purpose: Restores database port exposure for local development tools
# (e.g., MongoDB Compass, redis-cli). These ports are NOT exposed in the
# production docker-compose.yml for security.

version: '3.8'

services:
  mongo:
    ports:
      - "27017:27017"  # ← Local dev only — allows MongoDB Compass connections

  redis:
    ports:
      - "6379:6379"   # ← Local dev only — allows redis-cli connections

  backend:
    environment:
      - NODE_ENV=development
