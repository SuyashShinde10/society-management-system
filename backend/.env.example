# Application Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/society-management

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
ADMIN_SECRET=your_admin_secret_key_here
ADMIN_SECRET_CODE=your_society_admin_registration_code_here

# Redis Cache & Background Queue Worker
REDIS_URL=redis://127.0.0.1:6379

# Email Service (Brevo / SendGrid / Custom SMTP)
EMAIL_SERVICE=brevo
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_login@domain.com
EMAIL_PASS=your_smtp_password_here
EMAIL_FROM=noreply@society-portal.com

# AI Services (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Optional image hosting)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payment Gateway (Optional)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
